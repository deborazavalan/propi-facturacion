# Copie este archivo como .env y ajuste los valores.
# La aplicación NO guarda usuarios ni contraseñas: cada persona entra con su login de SQL Server.

PORT=3000

# Servidor de SQL Server (use DB_INSTANCE si usa una instancia con nombre, por ejemplo SQLEXPRESS; entonces se ignora DB_PORT)
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_NAME=PropiDB

# Conexión cifrada. En desarrollo con certificado autofirmado deje DB_TRUST_CERT=true.
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Minutos de inactividad antes de cerrar la sesión (se registra la salida en la bitácora)
SESSION_IDLE_MIN=30

# Poner en true cuando se publique detrás de HTTPS
COOKIE_SECURE=false

# Solo si hay un proxy inverso delante (true o número de saltos); necesario para registrar la IP real del cliente
TRUST_PROXY=
